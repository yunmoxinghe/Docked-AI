<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Docked_AI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- 根据平台动态设置 PlatformTarget -->
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <!-- 默认使用 x64 平台 -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PublishProfile Condition="'$(Platform)' == 'x64'">win-x64.pubxml</PublishProfile>
    <PublishProfile Condition="'$(Platform)' == 'x86'">win-x86.pubxml</PublishProfile>
    <PublishProfile Condition="'$(Platform)' == 'ARM64'">win-arm64.pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- 尝试在框架依赖模式下启用 AOT -->
    <PublishAot>true</PublishAot>
    <!-- AOT 优化配置 -->
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <IlcInvariantGlobalization>false</IlcInvariantGlobalization>
    <!-- 更多 AOT 优化 -->
    <IlcDisableReflection>false</IlcDisableReflection>
    <IlcTrimMetadata>true</IlcTrimMetadata>
    <IlcOptimizationLevel>3</IlcOptimizationLevel>
    <!-- 忽略无效的 PRI 限定符警告 -->
    <NoWarn>$(NoWarn);PRI249</NoWarn>
    <!-- 框架依赖模式使用标准裁剪 -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <!-- 更激进的裁剪选项 -->
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <!-- 极限裁剪 -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- 额外体积优化 -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只包含必需的资源文件 -->
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\Sparkles.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="功能\应用入口\App.xaml" />
    <ApplicationDefinition Include="功能\应用入口\App.xaml" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <!-- 保留 CommunityToolkit.WinUI.Controls.SettingsControls - 依赖复杂，保持 NuGet 引用 -->
    <!-- 已移除 DevWinUI.Controls - 使用自定义 KeyVisual -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.251221100" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.3.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <!-- 已移除 DevWinUI NuGet，改用本地源码 -->
    <!-- 移除 NHotkey.WinUI NuGet，改用本地源码 -->
  </ItemGroup>

  <!-- 排除临时下载的源码目录，第三方源码会选择性包含 -->
  <ItemGroup>
    <Compile Remove="Vendors_Temp\**" />
    <EmbeddedResource Remove="Vendors_Temp\**" />
    <None Remove="Vendors_Temp\**" />
    <Page Remove="Vendors_Temp\**" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <ApplicationIcon>Assets\Sparkles.ico</ApplicationIcon>
    <GenerateTemporaryStoreCertificate>False</GenerateTemporaryStoreCertificate>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x64|arm64</AppxBundlePlatforms>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <AppxPackageDir>AppPackages\</AppxPackageDir>
    <UapAppxPackageBuildMode>StoreUpload</UapAppxPackageBuildMode>
    <!-- 启用资源包压缩 -->
    <AppxPackageAllowDebugFrameworkReferencesInManifest>false</AppxPackageAllowDebugFrameworkReferencesInManifest>
    <UseDotNetNativeToolchain>true</UseDotNetNativeToolchain>
    <PackageCertificateKeyFile>Docked AI_StoreKey.pfx</PackageCertificateKeyFile>
  </PropertyGroup>

  <!-- Release 优化 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <!-- 禁用调试符号 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 优化编译 -->
    <Optimize>true</Optimize>
    <TieredCompilation>false</TieredCompilation>
    <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
    <!-- 移除不必要的功能 -->
    <EventSourceSupport>false</EventSourceSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <InvariantGlobalization>false</InvariantGlobalization>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <!-- 额外的运行时优化 -->
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <IlcGenerateDgmlFile>false</IlcGenerateDgmlFile>
    <IlcGenerateMapFile>false</IlcGenerateMapFile>
    <IlcGenerateMstatFile>false</IlcGenerateMstatFile>
    <!-- 启用 PGO (Profile-Guided Optimization) -->
    <TieredPGO>true</TieredPGO>
    <DynamicPGO>true</DynamicPGO>
  </PropertyGroup>

  <!-- MSIX 打包优化 -->
  <PropertyGroup>
    <!-- 压缩优化 -->
    <AppxPackageCompression>maximum</AppxPackageCompression>
  </PropertyGroup>

  <!-- 调试时自动结束旧进程 -->
  <Target Name="KillDockedAIProcess" BeforeTargets="PreBuildEvent">
    <Exec Command="taskkill /F /IM &quot;Docked AI.exe&quot; 2&gt;nul || exit 0" IgnoreExitCode="true" />
  </Target>
</Project>
