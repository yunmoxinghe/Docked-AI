<Page
    x:Class="DockedTools.Features.Pages.Settings.WebSettings.WebAppManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:DockedTools.Features.Pages.Settings.WebSettings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseLayoutRounding="True"
    NavigationCacheMode="Required">
    
    <!-- ⭐ 禁用 Page 级别的所有过渡动画 -->
    <Page.Transitions>
        <TransitionCollection/>
    </Page.Transitions>

    <Grid
        x:Name="RootGrid"
        Padding="0"
        UseLayoutRounding="True">
        <!-- ⭐ 禁用 Grid 的所有过渡动画 -->
        <Grid.Transitions>
            <TransitionCollection/>
        </Grid.Transitions>
        <ScrollViewer
            x:Name="PageScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageContentPanel"
                Margin="16,0"
                UseLayoutRounding="True"
                Spacing="0">
                <!-- ⭐ 禁用 StackPanel 的过渡动画 -->
                <StackPanel.Transitions>
                    <TransitionCollection/>
                </StackPanel.Transitions>
                <Border Height="40" />
                <TextBlock
                    x:Name="PageTitleBlock"
                    x:Uid="WebAppManagementPage_Title"
                    Text="网页应用管理"
                    FontSize="32"
                    FontWeight="SemiBold" />
                <Border Height="36" />

                <StackPanel
                    x:Name="CardsPanel"
                    Spacing="4">
                    <!-- ⭐ 禁用 CardsPanel 的过渡动画 -->
                    <StackPanel.Transitions>
                        <TransitionCollection/>
                    </StackPanel.Transitions>
                    
                    <!-- 添加新应用按钮 -->
                    <controls:SettingsCard 
                        x:Uid="WebAppManagementPage_AddNewHeader"
                        Header="添加网页应用"
                        Description="创建新的网页应用快捷方式"
                        IsClickEnabled="True"
                        Click="OnAddNewAppClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE76C;"/>
                        </controls:SettingsCard.ActionIcon>
                    </controls:SettingsCard>

                    <!-- 应用列表 -->
                    <TextBlock 
                        x:Uid="WebAppManagementPage_AppListSection"
                        Text="已添加的应用"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="1,16,0,4"
                        Visibility="{x:Bind HasApps, Mode=OneWay}"/>

                    <StackPanel
                        x:Name="AppsListPanel"
                        Spacing="4">
                        <!-- ⭐ 添加删除动画：使用 WinUI 3 标准的 AddDeleteThemeTransition -->
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                    </StackPanel>

                    <!-- 空状态提示 -->
                    <StackPanel
                        x:Name="EmptyStatePanel"
                        Visibility="{x:Bind HasNoApps, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Margin="0,48,0,0">
                        <FontIcon 
                            Glyph="&#xE8F1;" 
                            FontSize="64"
                            Opacity="0.3"
                            HorizontalAlignment="Center"/>
                        <TextBlock 
                            x:Uid="WebAppManagementPage_EmptyState"
                            Text="还没有添加任何网页应用"
                            FontSize="16"
                            Opacity="0.6"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"/>
                        <TextBlock 
                            x:Uid="WebAppManagementPage_EmptyStateHint"
                            Text="点击上方「添加网页应用」按钮开始添加"
                            FontSize="14"
                            Opacity="0.5"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Border Height="40" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
