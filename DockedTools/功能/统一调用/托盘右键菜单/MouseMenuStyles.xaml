<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- 🖱️ 鼠标模式：紧凑菜单样式 (28px) -->
    <x:Double x:Key="MenuFlyoutItemThemeMinHeight">28</x:Double>
    <x:Double x:Key="MenuFlyoutSubItemThemeMinHeight">28</x:Double>
    <x:Double x:Key="MenuFlyoutSeparatorThemeHeight">1</x:Double>
    
    <!-- 鼠标模式的 MenuFlyoutItem 样式 - 基于默认样式 -->
    <Style x:Key="MouseMenuFlyoutItemStyle" TargetType="MenuFlyoutItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="12,6,12,6"/>
    </Style>
    
</ResourceDictionary>
