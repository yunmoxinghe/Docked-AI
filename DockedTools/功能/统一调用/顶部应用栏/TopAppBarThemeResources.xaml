<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 亮色主题的亚克力 -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <AcrylicBrush x:Key="TopAppBarAcrylicBrush"
                          TintColor="#F3F3F3"
                          TintOpacity="0.5"
                          TintLuminosityOpacity="0.85"
                          FallbackColor="#F3F3F3" />
            
            <SolidColorBrush x:Key="TopAppBarForegroundBrush" Color="#000000" />
        </ResourceDictionary>

        <!-- 深色主题的亚克力 -->
        <ResourceDictionary x:Key="Dark">
            <AcrylicBrush x:Key="TopAppBarAcrylicBrush"
                          TintColor="#2C2C2C"
                          TintOpacity="0.8"
                          TintLuminosityOpacity="0.96"
                          FallbackColor="#2C2C2C" />
            
            <SolidColorBrush x:Key="TopAppBarForegroundBrush" Color="#FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
