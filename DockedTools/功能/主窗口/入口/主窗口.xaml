<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DockedTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DockedTools"
    xmlns:linker="using:DockedTools.Features.MainWindowContent.Linker"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="DockedTools">

    <Grid x:Name="RootGrid" 
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          IsTabStop="True"
          UseSystemFocusVisuals="False"
          PreviewKeyDown="RootGrid_PreviewKeyDown">
        <!-- ==================== 快捷键定义 ==================== -->
        <Grid.KeyboardAccelerators>
            <!-- Ctrl + 1~8: 快速切换到对应的网页应用标签 -->
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnSwitchToTab1"/>
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnSwitchToTab2"/>
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnSwitchToTab3"/>
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="OnSwitchToTab4"/>
            <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="OnSwitchToTab5"/>
            <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="OnSwitchToTab6"/>
            <KeyboardAccelerator Key="Number7" Modifiers="Control" Invoked="OnSwitchToTab7"/>
            <KeyboardAccelerator Key="Number8" Modifiers="Control" Invoked="OnSwitchToTab8"/>
            
            <!-- Ctrl + 9: 快速切换到最后一个网页应用标签（符合浏览器习惯） -->
            <KeyboardAccelerator Key="Number9" Modifiers="Control" Invoked="OnSwitchToTab9"/>
            
            <!-- Ctrl + Tab: 切换到下一个网页应用标签（循环） -->
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="OnSwitchToNextTab"/>
            
            <!-- ⚠️ Ctrl + D 不使用 KeyboardAccelerator，因为会被 WinUI 吞掉 -->
            <!-- 改用 PreviewKeyDown 处理（见快捷键管理器） -->
        </Grid.KeyboardAccelerators>
        
        <linker:Linker x:Name="MainLinker" />
        
        <!-- Splash 遮罩 - 默认可见，作为启动时的第一屏 -->
        <Grid x:Name="SplashOverlay"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Visibility="Visible"
              Opacity="1">
            <Grid.Resources>
                <!-- 淡入动画：纯色到启动屏幕 -->
                <Storyboard x:Name="SplashFadeIn">
                    <DoubleAnimation Storyboard.TargetName="ColorOverlay"
                                     Storyboard.TargetProperty="Opacity"
                                     From="1" To="0"
                                     Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                
                <!-- 淡出动画：启动屏幕到主界面 -->
                <Storyboard x:Name="SplashFadeOut">
                    <DoubleAnimation Storyboard.TargetName="SplashOverlay"
                                     Storyboard.TargetProperty="Opacity"
                                     From="1" To="0"
                                     Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            
            <!-- 启动屏幕图片 -->
            <Image Source="ms-appx:///Assets/SplashScreen.png"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="None"/>
            
            <!-- 纯色遮罩层（根据主题自动切换黑白） -->
            <Rectangle x:Name="ColorOverlay"
                       Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                       Opacity="1"/>
        </Grid>
    </Grid>
</Window>
