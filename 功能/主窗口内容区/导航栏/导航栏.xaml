<UserControl
    x:Class="Docked_AI.Features.MainWindowContent.NavigationBar.NavigationBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 隐藏 NavigationView 内部 ScrollViewer 的滚动条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        
        <!-- 自定义 NavigationView 样式，移除所有内边距 -->
        <Style x:Key="CompactNavViewStyle" TargetType="controls:NavigationView">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Width="48" HorizontalAlignment="Right">
        <Grid.RowDefinitions>
            <!-- 顶部固定按钮区域 -->
            <RowDefinition Height="Auto"/>
            <!-- 分割线 -->
            <RowDefinition Height="Auto"/>
            <!-- 主导航区域（中间可滚动 + 底部固定） -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部固定的 NavigationView -->
        <controls:NavigationView
            x:Name="TopNavView"
            Grid.Row="0"
            Style="{StaticResource CompactNavViewStyle}"
            Width="48"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsPaneOpen="False"
            PaneDisplayMode="LeftCompact"
            CompactPaneLength="48"
            ItemInvoked="TopNavView_ItemInvoked"
            FlowDirection="RightToLeft"
            IsEnabled="True">
            <controls:NavigationView.MenuItems>
                <!-- 最大化/还原按钮 -->
                <controls:NavigationViewItem
                    x:Name="WindowStateToggleNavigationItem"
                    x:Uid="Nav_WindowStateToggle"
                    Tag="windowstate"
                    SelectsOnInvoked="False">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon
                            x:Name="WindowStateIcon"
                            Glyph="&#xE740;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem
                    x:Name="HomeNavigationItem"
                    x:Uid="Nav_Home"
                    Tag="0"
                    IsSelected="True">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>
        </controls:NavigationView>
        
        <!-- 分割线 -->
        <Border
            Grid.Row="1"
            Height="1"
            Margin="8,0"
            Background="{ThemeResource NavigationViewItemSeparatorForeground}"
            Opacity="0.6"/>

        <!-- 主导航栏（中间可滚动 + 底部固定） -->
        <controls:NavigationView
            x:Name="NavView"
            Grid.Row="2"
            Style="{StaticResource CompactNavViewStyle}"
            Width="48"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsPaneOpen="False"
            PaneDisplayMode="LeftCompact"
            OpenPaneLength="220"
            CompactPaneLength="48"
            SelectionChanged="NavView_SelectionChanged"
            ItemInvoked="NavView_ItemInvoked"
            FlowDirection="RightToLeft"
            ScrollViewer.VerticalScrollBarVisibility="Hidden"
            ScrollViewer.HorizontalScrollBarVisibility="Hidden">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem
                    x:Name="AINavigationItem"
                    x:Uid="Nav_AI"
                    Tag="2">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF4A5;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem
                    x:Name="CreateNavigationItem"
                    x:Uid="Nav_New"
                    Tag="1">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>
            
            <controls:NavigationView.FooterMenuItems>
                <!-- 分割线 -->
                <controls:NavigationViewItemSeparator />
                
                <controls:NavigationViewItem
                    x:Name="DockToggleNavigationItem"
                    x:Uid="Nav_DockToggle"
                    Tag="dock"
                    SelectsOnInvoked="False">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon
                            x:Name="DockToggleIcon"
                            Glyph="&#xE89F;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem
                    x:Name="SettingsNavigationItem"
                    x:Uid="Nav_Settings"
                    Tag="settings"
                    PointerEntered="SettingsNavigationItem_PointerEntered"
                    PointerExited="SettingsNavigationItem_PointerExited">
                    <controls:NavigationViewItem.Icon>
                        <AnimatedIcon x:Name="SettingsAnimatedIcon">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedSettingsVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Setting" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem
                    x:Name="BackNavigationItem"
                    x:Uid="Nav_Back"
                    Tag="back"
                    SelectsOnInvoked="False"
                    Visibility="Collapsed"
                    PointerEntered="BackNavigationItem_PointerEntered"
                    PointerExited="BackNavigationItem_PointerExited">
                    <controls:NavigationViewItem.Icon>
                        <AnimatedIcon x:Name="BackAnimatedIcon">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedBackVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE72B;" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.FooterMenuItems>
        </controls:NavigationView>
    </Grid>
</UserControl>
