<UserControl
    x:Class="Docked_AI.Features.MainWindowContent.ContentArea.ContentArea"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:animations="using:Microsoft.UI.Xaml.Media.Animation"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:topAppBar="using:Docked_AI.Features.UnifiedCalls.TopAppBar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="ContentBorder"
        CornerRadius="4"
        Padding="0"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1">
        <Grid>
            <!-- 第零层：背景（根据设置动态切换） -->
            <Grid x:Name="BackdropContainer">
                <!-- 默认纯色背景 -->
                <Border x:Name="SolidColorBackdrop" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="Visible"/>
                
                <!-- 云母 Base 背景 -->
                <controls:SystemBackdropElement x:Name="MicaBaseBackdropLayer" 
                                                 CornerRadius="4"
                                                 Visibility="Collapsed">
                    <controls:SystemBackdropElement.SystemBackdrop>
                        <media:MicaBackdrop Kind="Base"/>
                    </controls:SystemBackdropElement.SystemBackdrop>
                </controls:SystemBackdropElement>
                
                <!-- 云母 Alt 背景 -->
                <controls:SystemBackdropElement x:Name="MicaAltBackdropLayer" 
                                                 CornerRadius="4"
                                                 Visibility="Collapsed">
                    <controls:SystemBackdropElement.SystemBackdrop>
                        <media:MicaBackdrop Kind="BaseAlt"/>
                    </controls:SystemBackdropElement.SystemBackdrop>
                </controls:SystemBackdropElement>
                
                <!-- 亚克力背景 -->
                <controls:SystemBackdropElement x:Name="AcrylicBackdropLayer" 
                                                 CornerRadius="4"
                                                 Visibility="Collapsed">
                    <controls:SystemBackdropElement.SystemBackdrop>
                        <media:DesktopAcrylicBackdrop/>
                    </controls:SystemBackdropElement.SystemBackdrop>
                </controls:SystemBackdropElement>
            </Grid>
            
            <!-- 内容层 -->
            <Grid x:Name="ContentGrid"
                  PointerPressed="ContentGrid_PointerPressed">
            <!-- 第一层：页面内容 Frame -->
            <controls:Frame
                x:Name="ContentFrame"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                SizeChanged="ContentFrame_SizeChanged">
                <controls:Frame.ContentTransitions>
                    <TransitionCollection>
                        <animations:NavigationThemeTransition>
                            <animations:NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <animations:DrillInNavigationTransitionInfo />
                            </animations:NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </animations:NavigationThemeTransition>
                    </TransitionCollection>
                </controls:Frame.ContentTransitions>
            </controls:Frame>

            <!-- 第二层：通用控件/装饰层 -->
            <Grid
                x:Name="OverlayLayer"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False" />

            <!-- 第三层：顶部应用栏（独立控件管理 UI） -->
            <topAppBar:TopAppBarControl
                x:Name="TopAppBarHost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
