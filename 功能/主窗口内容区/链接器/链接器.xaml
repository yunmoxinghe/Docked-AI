<UserControl
    x:Class="Docked_AI.Features.MainWindowContent.Linker.Linker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:navBar="using:Docked_AI.Features.MainWindowContent.NavigationBar"
    xmlns:contentArea="using:Docked_AI.Features.MainWindowContent.ContentArea"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="RootLayout"
        Background="Transparent"
        Padding="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftNavigationColumn" Width="0" />
            <ColumnDefinition x:Name="LeftNavigationGapColumn" Width="0" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightNavigationGapColumn" Width="2" />
            <ColumnDefinition x:Name="RightNavigationColumn" Width="48" />
        </Grid.ColumnDefinitions>

        <contentArea:ContentArea
            x:Name="ContentHost"
            Grid.Column="2"
            Margin="4,6,4,4" />

        <navBar:NavigationBar
            x:Name="NavBar"
            Grid.Column="4"
            VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
