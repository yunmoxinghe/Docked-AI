<Page
    x:Class="Docked_AI.Features.Pages.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:customControls="using:Docked_AI.Features.UnifiedCalls.CustomControls"
    mc:Ignorable="d"
    UseLayoutRounding="True">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition />
        </TransitionCollection>
    </Page.Transitions>

    <Grid
        x:Name="RootGrid"
        Padding="0"
        UseLayoutRounding="True">
        <ScrollViewer
            x:Name="SettingsScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageContentPanel"
                Margin="16,0"
                UseLayoutRounding="True"
                Spacing="0">
                <Border Height="40" />
                <TextBlock
                    x:Name="PageTitleBlock"
                    x:Uid="SettingsPage_Title"
                    FontSize="32"
                    FontWeight="SemiBold" />
                <Border Height="36" />

                <StackPanel
                    x:Name="CardsPanel"
                    Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <EntranceThemeTransition FromVerticalOffset="50" />
                        <RepositionThemeTransition IsStaggeringEnabled="True" />
                    </StackPanel.ChildrenTransitions>
                    <!-- 当状态为 DisabledByUser 时显示提示信息 -->
                    <InfoBar
                        x:Uid="SettingsPage_UserDisabledInfo"
                        Severity="Informational"
                        IsOpen="{x:Bind ViewModel.ShowUserDisabledInfo, Mode=OneWay}"
                        IsClosable="False"
                        Visibility="{x:Bind ViewModel.ShowUserDisabledInfo, Mode=OneWay}"/>

                    <!-- 当状态为 DisabledByPolicy 时显示警告 -->
                    <InfoBar
                        x:Uid="SettingsPage_PolicyWarning"
                        Severity="Warning"
                        IsOpen="{x:Bind ViewModel.ShowPolicyWarning, Mode=OneWay}"
                        IsClosable="False"
                        Visibility="{x:Bind ViewModel.ShowPolicyWarning, Mode=OneWay}"/>

                    <!-- 常规设置 -->
                    <TextBlock 
                        x:Uid="SettingsPage_GeneralSection"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="1,16,0,4"/>
                    
                    <!-- 开机自启动设置 -->
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_StartupHeader"
                        IsClickEnabled="True"
                        Click="OnSettingCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7B5;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;"/>
                        </controls:SettingsCard.ActionIcon>
                        <ToggleSwitch 
                            IsOn="{x:Bind ViewModel.IsStartupEnabled, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanToggle, Mode=OneWay}"
                            Toggled="OnToggleSwitched"/>
                    </controls:SettingsCard>

                    <!-- 窗口停靠位置设置 -->
                    <controls:SettingsExpander
                        x:Name="DockSideExpander"
                        x:Uid="SettingsPage_DockSideHeader"
                        Header="窗口停靠位置"
                        Description="选择窗口停靠在屏幕的左侧或右侧"
                        IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE746;"/>
                        </controls:SettingsExpander.HeaderIcon>
                        <ComboBox
                            x:Name="DockSideComboBox"
                            MinWidth="150"
                            SelectionChanged="OnDockSideChanged">
                            <ComboBoxItem x:Uid="SettingsPage_DockSideLeft" Tag="0" Content="左侧"/>
                            <ComboBoxItem x:Uid="SettingsPage_DockSideRight" Tag="1" Content="右侧"/>
                        </ComboBox>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="SettingsPage_LeftDockNavigationHeader">
                                <ToggleSwitch
                                    x:Name="LeftDockNavigationToggle"
                                    Toggled="OnLeftDockNavigationToggled"/>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsCard
                        x:Uid="SettingsPage_LanguageHeader"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnLanguageCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF2B7;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="LanguageComboBox"
                            MinWidth="200"
                            SelectionChanged="OnLanguageChanged">
                            <ComboBoxItem x:Uid="SettingsPage_LanguageSystem" Tag="" Content="跟随系统"/>
                            <ComboBoxItem Tag="zh-CN" Content="简体中文"/>
                            <ComboBoxItem Tag="zh-TW" Content="繁體中文"/>
                            <ComboBoxItem Tag="en-US" Content="English"/>
                            <ComboBoxItem Tag="ja-JP" Content="日本語"/>
                            <ComboBoxItem Tag="ko-KR" Content="한국어"/>
                            <ComboBoxItem Tag="fr-FR" Content="Français"/>
                            <ComboBoxItem Tag="de-DE" Content="Deutsch"/>
                            <ComboBoxItem Tag="es-ES" Content="Español"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <!-- 交互设置 -->
                    <TextBlock 
                        x:Uid="SettingsPage_InteractionSection"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="1,16,0,4"/>

                    <!-- 托盘关闭窗口行为 -->
                    <controls:SettingsCard
                        x:Uid="SettingsPage_TrayCloseWindowBehaviorHeader"
                        Header="托盘关闭窗口行为"
                        Description="选择点击托盘'关闭窗口'按钮时的行为"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnTrayCloseWindowBehaviorCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEA99;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="TrayCloseWindowBehaviorComboBox"
                            MinWidth="200"
                            SelectionChanged="OnTrayCloseWindowBehaviorChanged">
                            <ComboBoxItem x:Uid="SettingsPage_TrayCloseDestroyWindow" Tag="0" Content="直接销毁窗口"/>
                            <ComboBoxItem x:Uid="SettingsPage_TrayCloseRestartToTray" Tag="1" Content="重启到仅托盘"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <!-- 侧边栏返回按钮 -->
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_BackButtonHeader"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnBackButtonCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE72B;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="BackButtonToggle"
                            Toggled="OnBackButtonToggled"/>
                    </controls:SettingsCard>

                    <!-- Frame 导航动画设置 -->
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_FrameAnimationHeader"
                        IsClickEnabled="True"
                        Click="OnFrameAnimationCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE945;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="" />
                        </controls:SettingsCard.ActionIcon>
                        <ComboBox 
                            x:Name="FrameAnimationComboBox"
                            MinWidth="200"
                            SelectionChanged="OnFrameAnimationChanged">
                            <ComboBoxItem x:Uid="SettingsPage_AnimationNone" Tag="0"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationEntrance" Tag="1"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationSlideRight" Tag="2"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationSlideLeft" Tag="3"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationSlideBottom" Tag="4"/>
                            <ComboBoxItem x:Uid="SettingsPage_AnimationDrill" Tag="5"/>
                        </ComboBox>
                    </controls:SettingsCard>

                    <!-- 全局快捷键设置 -->
                    <controls:SettingsExpander x:Name="HotkeyExpander"
                                          x:Uid="SettingsPage_HotkeyHeader"
                                          IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE765;"/>
                        </controls:SettingsExpander.HeaderIcon>
                        
                        <ToggleSwitch 
                            x:Name="HotkeyToggle"
                            Toggled="OnHotkeyToggled"/>
                        
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="SettingsPage_HotkeyConfigHeader"
                                              IsClickEnabled="True"
                                              Click="OnHotkeyButtonClick">
                                <ItemsControl x:Name="HotkeyKeysDisplay" 
                                            HorizontalAlignment="Right">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <customControls:KeyVisual Content="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </controls:SettingsCard>
                            
                            <controls:SettingsCard x:Uid="SettingsPage_TouchpadSettingsHeader"
                                              IsClickEnabled="True"
                                              Click="OnTouchpadSettingsClick">
                                <controls:SettingsCard.ActionIcon>
                                    <FontIcon Glyph="&#xE8A7;"/>
                                </controls:SettingsCard.ActionIcon>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!-- 网页设置 -->
                    <TextBlock 
                        x:Uid="SettingsPage_WebSection"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="1,16,0,4"/>
                    
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_MaxWebViewHeader"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnMaxWebViewCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE774;" />
                        </controls:SettingsCard.HeaderIcon>
                        <NumberBox 
                            x:Name="MaxWebViewCountBox"
                            Minimum="1"
                            Maximum="20"
                            SpinButtonPlacementMode="Inline"
                            SmallChange="1"
                            LargeChange="5"
                            Width="120"
                            ValueChanged="OnMaxWebViewCountChanged"/>
                    </controls:SettingsCard>

                    <!-- WebView2 性能优化 -->
                    <controls:SettingsExpander
                        x:Name="WebViewPerformanceExpander"
                        x:Uid="SettingsPage_WebViewPerformanceHeader"
                        Header="WebView2 性能优化"
                        Description="配置 WebView2 的内存和性能设置"
                        IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE9D9;"/>
                        </controls:SettingsExpander.HeaderIcon>
                        
                        <controls:SettingsExpander.Items>
                            <!-- 快速启动模式 -->
                            <controls:SettingsCard
                                x:Uid="SettingsPage_FastStartupModeHeader"
                                Header="快速启动模式"
                                Description="优化首次网页打开速度（需重启 WebView）">
                                <ToggleSwitch
                                    x:Name="FastStartupModeToggle"
                                    Toggled="OnFastStartupModeToggled"/>
                            </controls:SettingsCard>

                            <!-- 单进程模式 -->
                            <controls:SettingsCard
                                x:Uid="SettingsPage_SingleProcessModeHeader"
                                Header="单进程模式"
                                Description="减少辅助进程，降低内存占用（需重启 WebView，可能影响稳定性）">
                                <ToggleSwitch
                                    x:Name="SingleProcessModeToggle"
                                    Toggled="OnSingleProcessModeToggled"/>
                            </controls:SettingsCard>

                            <!-- 内存模式 -->
                            <controls:SettingsCard
                                x:Uid="SettingsPage_MemoryModeHeader"
                                Header="内存模式"
                                Description="选择内存占用策略">
                                <ComboBox
                                    x:Name="MemoryModeComboBox"
                                    MinWidth="150"
                                    SelectionChanged="OnMemoryModeChanged">
                                    <ComboBoxItem x:Uid="SettingsPage_MemoryModeNormal" Tag="0" Content="正常"/>
                                    <ComboBoxItem x:Uid="SettingsPage_MemoryModeLow" Tag="1" Content="低内存"/>
                                </ComboBox>
                            </controls:SettingsCard>

                            <!-- 自动清理缓存 -->
                            <controls:SettingsCard
                                x:Uid="SettingsPage_AutoClearCacheHeader"
                                Header="自动清理缓存"
                                Description="定期清理浏览数据和缓存">
                                <ToggleSwitch
                                    x:Name="AutoClearCacheToggle"
                                    Toggled="OnAutoClearCacheToggled"/>
                            </controls:SettingsCard>

                            <!-- 暂停不活跃的 WebView -->
                            <controls:SettingsCard
                                x:Uid="SettingsPage_SuspendInactiveHeader"
                                Header="暂停不活跃标签页"
                                Description="自动暂停后台标签页以节省资源">
                                <ToggleSwitch
                                    x:Name="SuspendInactiveToggle"
                                    Toggled="OnSuspendInactiveToggled"/>
                            </controls:SettingsCard>

                            <!-- 禁用后台网络 -->
                            <controls:SettingsCard
                                x:Uid="SettingsPage_DisableBackgroundNetworkHeader"
                                Header="禁用后台网络"
                                Description="禁用后台网络请求（需重启 WebView）">
                                <ToggleSwitch
                                    x:Name="DisableBackgroundNetworkToggle"
                                    Toggled="OnDisableBackgroundNetworkToggled"/>
                            </controls:SettingsCard>

                            <!-- 禁用扩展 -->
                            <controls:SettingsCard
                                x:Uid="SettingsPage_DisableExtensionsHeader"
                                Header="禁用浏览器扩展"
                                Description="禁用浏览器扩展（需重启 WebView）">
                                <ToggleSwitch
                                    x:Name="DisableExtensionsToggle"
                                    Toggled="OnDisableExtensionsToggled"/>
                            </controls:SettingsCard>

                            <!-- 禁用插件 -->
                            <controls:SettingsCard
                                x:Uid="SettingsPage_DisablePluginsHeader"
                                Header="禁用浏览器插件"
                                Description="禁用浏览器插件（需重启 WebView）">
                                <ToggleSwitch
                                    x:Name="DisablePluginsToggle"
                                    Toggled="OnDisablePluginsToggled"/>
                            </controls:SettingsCard>

                            <!-- 磁盘缓存大小 -->
                            <controls:SettingsCard
                                x:Uid="SettingsPage_DiskCacheSizeHeader"
                                Header="磁盘缓存大小"
                                Description="限制磁盘缓存大小（MB，需重启 WebView）">
                                <NumberBox
                                    x:Name="DiskCacheSizeBox"
                                    Minimum="10"
                                    Maximum="500"
                                    SpinButtonPlacementMode="Inline"
                                    SmallChange="10"
                                    LargeChange="50"
                                    Width="120"
                                    ValueChanged="OnDiskCacheSizeChanged"/>
                            </controls:SettingsCard>

                            <!-- GPU 加速优化 -->
                            <controls:SettingsCard
                                x:Uid="SettingsPage_EnableHardwareAccelerationHeader"
                                Header="启用硬件加速"
                                Description="使用 GPU 加速渲染（需重启 WebView）">
                                <ToggleSwitch
                                    x:Name="EnableHardwareAccelerationToggle"
                                    Toggled="OnEnableHardwareAccelerationToggled"/>
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                x:Uid="SettingsPage_EnableHardwareOverlaysHeader"
                                Header="启用硬件叠加层"
                                Description="使用硬件叠加层优化视频播放（需重启 WebView）">
                                <ToggleSwitch
                                    x:Name="EnableHardwareOverlaysToggle"
                                    Toggled="OnEnableHardwareOverlaysToggled"/>
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                x:Uid="SettingsPage_EnableHardwareVideoDecoderHeader"
                                Header="启用硬件视频解码"
                                Description="使用 GPU 解码视频（需重启 WebView）">
                                <ToggleSwitch
                                    x:Name="EnableHardwareVideoDecoderToggle"
                                    Toggled="OnEnableHardwareVideoDecoderToggled"/>
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                x:Uid="SettingsPage_DisableSoftwareRasterizerHeader"
                                Header="禁用软件光栅化"
                                Description="强制使用 GPU 渲染（需重启 WebView）">
                                <ToggleSwitch
                                    x:Name="DisableSoftwareRasterizerToggle"
                                    Toggled="OnDisableSoftwareRasterizerToggled"/>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!-- 高级设置 -->
                    <TextBlock 
                        x:Uid="SettingsPage_AdvancedSection"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="1,16,0,4"/>

                    <!-- AI 实验室 -->
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_AILabHeader"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnAILabCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF4A5;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="AILabToggle"
                            Toggled="OnAILabToggled"/>
                    </controls:SettingsCard>

                    <!-- WinUI 右键菜单 -->
                    <controls:SettingsCard 
                        x:Uid="SettingsPage_WinUIContextMenuHeader"
                        IsClickEnabled="True"
                        IsActionIconVisible="False"
                        Click="OnWinUIContextMenuCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8C1;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="WinUIContextMenuToggle"
                            Toggled="OnWinUIContextMenuToggled"/>
                    </controls:SettingsCard>

                    <!-- 实验室入口 -->
                    <controls:SettingsCard
                        x:Uid="SettingsPage_LabHeader"
                        IsClickEnabled="True"
                        Click="OnLabCardClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF196;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE76C;"/>
                        </controls:SettingsCard.ActionIcon>
                    </controls:SettingsCard>

                    <!-- 关于 -->
                    <TextBlock 
                        x:Uid="SettingsPage_AboutSection"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="1,16,0,4"/>
                    
                    <controls:SettingsExpander x:Name="AboutAppExpander"
                                          x:Uid="SettingsPage_AboutHeader"
                                          IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <BitmapIcon UriSource="ms-appx:///Assets/Sparkles.ico" ShowAsMonochrome="False"/>
                        </controls:SettingsExpander.HeaderIcon>
                        
                        <TextBlock x:Name="VersionText" 
                               x:Uid="SettingsPage_Version"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        
                        <controls:SettingsExpander.Items>
                            <!-- 评价应用 -->
                            <controls:SettingsCard 
                                x:Uid="SettingsPage_RateAppCard"
                                Header="评价应用"
                                Description="喜欢这个应用吗？给我们评分和评论吧！"
                                IsClickEnabled="True"
                                Click="OnRateAppClick">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE735;" />
                                </controls:SettingsCard.HeaderIcon>
                                <controls:SettingsCard.ActionIcon>
                                    <FontIcon Glyph="&#xE8A7;"/>
                                </controls:SettingsCard.ActionIcon>
                            </controls:SettingsCard>

                            <!-- 赞助作者 -->
                            <controls:SettingsCard 
                                x:Uid="SettingsPage_SponsorCard"
                                Header="赞助作者"
                                Description="如果这个应用对你有帮助，请考虑赞助支持开发"
                                IsClickEnabled="True"
                                Click="OnSponsorClick">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xEB51;" />
                                </controls:SettingsCard.HeaderIcon>
                                <controls:SettingsCard.ActionIcon>
                                    <FontIcon Glyph="&#xE8A7;"/>
                                </controls:SettingsCard.ActionIcon>
                            </controls:SettingsCard>
                            
                            <controls:SettingsCard x:Uid="SettingsPage_LinksHeader"
                                              HorizontalContentAlignment="Left"
                                              ContentAlignment="Left">
                                <StackPanel Margin="-12,0,0,0" Orientation="Vertical" Spacing="4">
                                    <HyperlinkButton Click="OnOpenGitHubClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8" />
                                            <TextBlock Text="{x:Bind GetGitHubLinkText()}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </HyperlinkButton>
                                    <HyperlinkButton Click="OnSendFeedbackClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xED15;" FontSize="16"/>
                                            <TextBlock Text="{x:Bind GetFeedbackLinkText()}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </HyperlinkButton>
                                    <HyperlinkButton x:Uid="SettingsPage_LicenseLink" Click="OnViewLicenseClick"/>
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                </StackPanel>

                <Border Height="40" />
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
