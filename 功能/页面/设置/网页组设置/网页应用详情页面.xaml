<Page
    x:Class="Docked_AI.Features.Pages.Settings.WebSettings.WebAppDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseLayoutRounding="True">

    <Grid
        x:Name="RootGrid"
        Padding="0"
        UseLayoutRounding="True">
        <ScrollViewer
            x:Name="PageScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageContentPanel"
                Margin="16,0"
                UseLayoutRounding="True"
                Spacing="0">
                <Border Height="40" />
                <TextBlock
                    x:Name="PageTitleBlock"
                    x:Uid="WebAppDetailPage_Title"
                    Text="编辑网页应用"
                    FontSize="32"
                    FontWeight="SemiBold" />
                <Border Height="36" />

                <StackPanel
                    x:Name="CardsPanel"
                    Spacing="4">
                    
                    <!-- 基本信息 -->
                    <TextBlock 
                        x:Uid="WebAppDetailPage_BasicInfoSection"
                        Text="基本信息"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="1,0,0,4"/>

                    <!-- 应用名称 -->
                    <controls:SettingsCard 
                        x:Uid="WebAppDetailPage_NameHeader"
                        Header="应用名称"
                        Description="显示在主页上的名称">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8AC;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBox 
                            x:Name="NameTextBox"
                            PlaceholderText="输入应用名称"
                            MinWidth="200"
                            MaxWidth="400"
                            HorizontalAlignment="Right"
                            TextChanged="OnFieldChanged"/>
                    </controls:SettingsCard>

                    <!-- 网站地址 -->
                    <controls:SettingsCard 
                        x:Uid="WebAppDetailPage_UrlHeader"
                        Header="网站地址"
                        Description="完整的 URL，包括 https://">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE71B;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBox 
                            x:Name="UrlTextBox"
                            PlaceholderText="https://example.com"
                            MinWidth="200"
                            MaxWidth="400"
                            HorizontalAlignment="Right"
                            TextChanged="OnFieldChanged"/>
                    </controls:SettingsCard>

                    <!-- 应用图标 -->
                    <TextBlock 
                        x:Uid="WebAppDetailPage_IconSection"
                        Text="应用图标"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="1,16,0,4"/>

                    <!-- 图标预览 -->
                    <controls:SettingsCard 
                        x:Uid="WebAppDetailPage_IconPreviewHeader"
                        Header="图标预览"
                        Description="当前应用图标">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE91B;" />
                        </controls:SettingsCard.HeaderIcon>
                        <Grid Width="64" Height="64">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid>
                                    <Image 
                                        x:Name="IconPreviewImage"
                                        Width="56" 
                                        Height="56"
                                        Stretch="UniformToFill"
                                        Visibility="Collapsed"/>
                                    <FontIcon 
                                        x:Name="IconPreviewFallback"
                                        Glyph="&#xE774;"
                                        FontSize="40"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </controls:SettingsCard>

                    <!-- 选择本地图片 -->
                    <controls:SettingsCard 
                        x:Uid="WebAppDetailPage_ChooseLocalIconHeader"
                        Header="选择本地图片"
                        Description="从设备中选择图片作为图标"
                        IsClickEnabled="True"
                        Click="OnChooseLocalIconClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B9;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8E5;"/>
                        </controls:SettingsCard.ActionIcon>
                    </controls:SettingsCard>

                    <!-- 从 URL 加载图标 -->
                    <controls:SettingsExpander
                        x:Name="IconUrlExpander"
                        x:Uid="WebAppDetailPage_IconUrlHeader"
                        Header="从 URL 加载图标"
                        Description="输入图片 URL 地址"
                        IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE71B;"/>
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                <StackPanel Orientation="Vertical" Spacing="8">
                                    <TextBox 
                                        x:Name="IconUrlTextBox"
                                        PlaceholderText="https://example.com/icon.png"
                                        MinWidth="200"
                                        HorizontalAlignment="Stretch"
                                        TextChanged="OnIconUrlChanged"/>
                                    <Button 
                                        x:Name="LoadIconFromUrlButton"
                                        x:Uid="WebAppDetailPage_LoadIconButton"
                                        Content="加载"
                                        Click="OnLoadIconFromUrlClick"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False"/>
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!-- 重置图标 -->
                    <controls:SettingsCard 
                        x:Uid="WebAppDetailPage_ResetIconHeader"
                        Header="重置图标"
                        Description="移除自定义图标，使用默认图标"
                        IsClickEnabled="True"
                        Click="OnResetIconClick">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE894;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE74D;"/>
                        </controls:SettingsCard.ActionIcon>
                    </controls:SettingsCard>

                    <!-- Cookie 管理（占位，暂不实现） -->
                    <TextBlock 
                        x:Uid="WebAppDetailPage_CookieSection"
                        Text="Cookie 管理"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Margin="1,16,0,4"/>

                    <controls:SettingsCard 
                        x:Uid="WebAppDetailPage_CookieHeader"
                        Header="Cookie 数据"
                        Description="查看和管理此应用的 Cookie（即将推出）"
                        IsEnabled="False">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE81C;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock 
                            Text="0 个 Cookie"
                            Opacity="0.6"/>
                    </controls:SettingsCard>

                    <!-- 状态提示 -->
                    <InfoBar
                        x:Name="StatusInfoBar"
                        IsOpen="False"
                        Severity="Informational"
                        Margin="0,16,0,0"/>
                </StackPanel>

                <Border Height="40" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
