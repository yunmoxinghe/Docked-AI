<UserControl
    x:Class="DockedAI.功能.页面.设置.网页组设置.IconPickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DockedAI.功能.页面.设置.网页组设置"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="IconTemplate" x:DataType="local:IconData">
            <!-- ItemsView 要求根元素必须是 ItemContainer -->
            <ItemContainer
                Width="80"
                Height="80"
                AutomationProperties.Name="{x:Bind Name}"
                CornerRadius="4"
                ToolTipService.ToolTip="{x:Bind Name}">
                <Grid
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    
                    <!-- 图标 -->
                    <Viewbox
                        Width="24"
                        Height="24"
                        Margin="0,0,0,16">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="{x:Bind Glyph}" />
                    </Viewbox>

                    <!-- 图标名称 -->
                    <TextBlock
                        Margin="4,0,4,4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="9"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>
            </ItemContainer>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <!-- 搜索框 -->
        <TextBox
            x:Name="SearchBox"
            x:Uid="IconPicker_Search"
            TextChanged="SearchBox_TextChanged" />

        <!-- 计数 -->
        <TextBlock
            x:Name="CountTextBlock"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- 图标网格（使用 ItemsView + UniformGridLayout 启用虚拟化） -->
        <ScrollViewer
            Height="500"
            VerticalScrollBarVisibility="Auto">
            <ItemsView
                x:Name="IconsItemsView"
                MinWidth="100"
                Padding="8"
                ItemTemplate="{StaticResource IconTemplate}"
                SelectionMode="Single"
                SelectionChanged="IconsItemsView_SelectionChanged">
                <ItemsView.Layout>
                    <UniformGridLayout
                        MinColumnSpacing="8"
                        MinRowSpacing="8"
                        Orientation="Horizontal" />
                </ItemsView.Layout>
            </ItemsView>
        </ScrollViewer>
    </StackPanel>
</UserControl>
