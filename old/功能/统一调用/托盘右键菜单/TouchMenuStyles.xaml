<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- 🖐️ 触摸模式：大间距菜单样式 (44px) -->
    <x:Double x:Key="MenuFlyoutItemThemeMinHeight">44</x:Double>
    <x:Double x:Key="MenuFlyoutSubItemThemeMinHeight">44</x:Double>
    <x:Double x:Key="MenuFlyoutSeparatorThemeHeight">2</x:Double>
    
    <!-- 触摸模式的 MenuFlyoutItem 样式 - 基于默认样式 -->
    <Style x:Key="TouchMenuFlyoutItemStyle" TargetType="MenuFlyoutItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="12,10,12,10"/>
    </Style>
    
</ResourceDictionary>
